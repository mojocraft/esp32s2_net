&pinctrl {

 uart0_default: uart0_default {
  group1 {
   pinmux = <(((43 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((14 & 0x1FFU) << 15U))>;
   output-high;
  };
  group2 {
   pinmux = <(((44 & 0x3FU) << 0U) | ((14 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>;
   bias-pull-up;
  };
 };

 spim2_default: spim2_default {
  group1 {
   pinmux = <(((13 & 0x3FU) << 0U) | ((109 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>,
     <(((12 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((108 & 0x1FFU) << 15U))>,
     <(((10 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((117 & 0x1FFU) << 15U))>;
  };
  group2 {
   pinmux = <(((11 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((110 & 0x1FFU) << 15U))>;
   output-low;
  };
 };

 spim3_default: spim3_default {
  group1 {
   pinmux = <(((37 & 0x3FU) << 0U) | ((73 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>,
     <(((36 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((72 & 0x1FFU) << 15U))>,
     <(((34 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((76 & 0x1FFU) << 15U))>;
  };
  group2 {
   pinmux = <(((35 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((74 & 0x1FFU) << 15U))>;
   output-low;
  };
 };

 i2c0_default: i2c0_default {
  group1 {
   pinmux = <(((8 & 0x3FU) << 0U) | ((30 & 0x1FFU) << 6U) | ((30 & 0x1FFU) << 15U))>,
     <(((9 & 0x3FU) << 0U) | ((29 & 0x1FFU) << 6U) | ((29 & 0x1FFU) << 15U))>;
   bias-pull-up;
   drive-open-drain;
   output-high;
  };
 };

 i2c1_default: i2c1_default {
  group1 {
   pinmux = <(((3 & 0x3FU) << 0U) | ((96 & 0x1FFU) << 6U) | ((96 & 0x1FFU) << 15U))>,
     <(((4 & 0x3FU) << 0U) | ((95 & 0x1FFU) << 6U) | ((95 & 0x1FFU) << 15U))>;
   bias-pull-up;
   drive-open-drain;
   output-high;
  };
 };

};
