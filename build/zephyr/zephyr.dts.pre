/ {
 chosen {
  zephyr,display = &display0;
 };

 display: display {
  status = "okay";
  compatible = "zephyr,mipi-dbi-spi";

  spi-dev = <&spi3>;
  dc-gpios = <&gpio0 13 (0 << 0)>;
  reset-gpios = <&gpio0 16 (1 << 0)>;
  write-only;

  #address-cells = <1>;
  #size-cells = <0>;

  display0: display0@0 {
   compatible = "sitronix,st7789v";
   status = "okay";
   reg = <0>;
   mipi-max-frequency = <40000000>;
   mipi-mode = <0x2>;





   height = <240>;
   width = <320>;
   x-offset = <0>;
   y-offset = <0>;
   vcom = <0x2B>;
   gctrl = <0x35>;
   vrhs = <0x0f>;
   vdvs = <0x20>;
   mdac = <0x60>;
   lcm = <0x2C>;
   colmod = <0x55>;
   gamma = <0x01>;
   inversion-off;


   porch-param = [0C 0C 00 33 33];
   cmd2en-param = [5a 69 02 01];
   pwctrl1-param = [52 A1];
   pvgam-param = [D0 00 02 07 0B 1A 31 54 40 29 12 12 12 17];
   nvgam-param = [D0 00 02 07 05 15 2D 44 44 1c 18 16 1c 1d];
   ram-param = [00 F8];
   rgb-param = [CD 08 14];


  };

 };

 backlight: backlight {
  compatible = "gpio-leds";
  bl: bl {
   gpios = <&gpio0 6 (0 << 0)>;
   label = "LCD BackLight";
  };
 };

};

&uart0 {
 status = "okay";
};

&spi3 {
 status = "okay";
 #address-cells = <1>;
 #size-cells = <0>;
 pinctrl-0 = <&spim3_default>;
 pinctrl-names = "default";
};

&spim3_default {
 group1 {
  pinmux = <(((8 & 0x3FU) << 0U) | ((73 & 0x1FFU) << 6U) | ((0x1FFU & 0x1FFU) << 15U))>,
    <(((9 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((74 & 0x1FFU) << 15U))>,
    <(((11 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((76 & 0x1FFU) << 15U))>;
 };
 group2 {
  pinmux = <(((15 & 0x3FU) << 0U) | ((0x1FFU & 0x1FFU) << 6U) | ((72 & 0x1FFU) << 15U))>;
  output-low;
 };
};

&wifi {
 status = "okay";
};

&trng0 {
 status = "okay";
};
